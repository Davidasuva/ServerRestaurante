<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="server.controller.productos.ProductosController"
      styleClass="raiz-admin"
      prefWidth="1100" prefHeight="700">

    <VBox HBox.hgrow="ALWAYS" spacing="0">

        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="20">
            <HBox alignment="CENTER" spacing="8">
                <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                    <image>
                        <Image url="@/images/Logo.png"/>
                    </image>
                </ImageView>
                <Label text="Carbón y Sazón" styleClass="nav-brand"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="mesas" styleClass="nav-link" onAction="#handleIrMesas"/>
            <Button text="pedidos" styleClass="nav-link" onAction="#handleIrPedidos"/>
            <Button text="productos" styleClass="nav-link-active"/>
            <Button text="ingredientes" styleClass="nav-link" onAction="#handleIrIngredientes"/>
            <Button text="empleados" styleClass="nav-link" onAction="#handleIrEmpleados"/>
        </HBox>

        <VBox VBox.vgrow="ALWAYS" spacing="0">
            <VBox.margin><Insets top="28" left="28" right="28" bottom="28"/></VBox.margin>

            <!-- ── Encabezado + control del servidor ── -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox spacing="4">
                    <Label text="Productos" styleClass="seccion-titulo"/>
                    <Label text="Gestiona el menú: platos, precios e ingredientes de cada producto."
                           styleClass="seccion-subtitulo"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER" spacing="8" styleClass="estado-caja">
                    <Region fx:id="indicador" styleClass="indicador, indicador-apagado"/>
                    <Label fx:id="lblEstado" text="Servidor apagado" styleClass="estado-texto"/>
                </HBox>
                <Button fx:id="btnConsola" text="Consola ▾" styleClass="btn-consola"
                        onAction="#handleToggleConsola"/>
                <Button fx:id="btnServidor" text="▶  Iniciar servidor" styleClass="btn-iniciar"
                        minWidth="180" onAction="#handleToggleServidor"/>
            </HBox>

            <!-- ── Consola desplegable (arranca cerrada, el controlador anima el alto) ── -->
            <VBox fx:id="panelConsola" styleClass="panel-consola"
                  minHeight="0" prefHeight="0" maxHeight="0">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Consola del servidor" styleClass="consola-titulo"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Limpiar" styleClass="btn-link" onAction="#handleLimpiarConsola"/>
                </HBox>
                <TextArea fx:id="txtConsola" styleClass="consola"
                          editable="false" wrapText="true"
                          promptText="Esperando eventos..."
                          minHeight="170" VBox.vgrow="ALWAYS"/>
            </VBox>

            <Region minHeight="20" maxHeight="20"/>

            <!-- ── Barra de acciones ── -->
            <HBox styleClass="barra-acciones" spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscar"
                           promptText="Buscar por nombre, categoría o id..."
                           styleClass="campo-busqueda"
                           prefWidth="340"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Actualizar" styleClass="btn-secundario" onAction="#handleRecargar"/>
                <Button text="+ Nuevo Producto" styleClass="btn-primario" onAction="#handleNuevo"/>
            </HBox>

            <Region minHeight="14" maxHeight="14"/>

            <!-- ── Tabla ── -->
            <TableView fx:id="tablaProductos" styleClass="tabla" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="Id" prefWidth="70"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="240"/>
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="160"/>
                    <TableColumn fx:id="colPrecio" text="Precio" prefWidth="130"/>
                </columns>
                <placeholder>
                    <Label text="No hay productos registrados." styleClass="seccion-subtitulo"/>
                </placeholder>
            </TableView>
        </VBox>
    </VBox>

    <!-- ── Panel derecho: formulario ── -->
    <VBox fx:id="panelForm" visible="false" managed="false" styleClass="panel-form" prefWidth="340" minWidth="340" maxWidth="340" spacing="0">

        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label fx:id="lblTituloForm" text="Nuevo producto" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="form-titulo"/>
            <Button text="✕ Cerrar" styleClass="btn-link" onAction="#handleCerrarForm"/>
        </HBox>
        <Region minHeight="22" maxHeight="22"/>

        <Label text="Id" styleClass="form-label"/>
        <Region minHeight="5" maxHeight="5"/>
        <TextField fx:id="txtId" promptText="Ej: 1" styleClass="campo"/>

        <Region minHeight="10" maxHeight="10"/>
        <Label text="Nombre" styleClass="form-label"/>
        <Region minHeight="5" maxHeight="5"/>
        <TextField fx:id="txtNombre" promptText="Ej: Bandeja paisa" styleClass="campo"/>

        <Region minHeight="10" maxHeight="10"/>
        <Label text="Categoría" styleClass="form-label"/>
        <Region minHeight="5" maxHeight="5"/>
        <ComboBox fx:id="cmbCategoria" styleClass="combo-campo" maxWidth="Infinity"
                  editable="true" promptText="Selecciona o escribe la categoría..."/>

        <Region minHeight="10" maxHeight="10"/>
        <Label text="Precio" styleClass="form-label"/>
        <Region minHeight="5" maxHeight="5"/>
        <TextField fx:id="txtPrecio" promptText="Ej: 25000" styleClass="campo"/>

        <Region minHeight="10" maxHeight="10"/>
        <Label text="Descripción" styleClass="form-label"/>
        <Region minHeight="5" maxHeight="5"/>
        <TextArea fx:id="txtDescripcion" promptText="Detalle opcional" styleClass="campo" wrapText="true" prefRowCount="2"/>

        <Region minHeight="10" maxHeight="10"/>
        <Label text="URL de la imagen" styleClass="form-label"/>
        <Region minHeight="5" maxHeight="5"/>
        <TextField fx:id="txtImagen" promptText="https://... (opcional)" styleClass="campo"/>

        <Region minHeight="12" maxHeight="12"/>
        <VBox fx:id="boxIngredientes" spacing="0">
            <Label text="Ingredientes del producto" styleClass="form-label"/>
            <Region minHeight="5" maxHeight="5"/>
            <ListView fx:id="lstIngredientes" styleClass="tabla" prefHeight="110" minHeight="110" maxHeight="110"/>
            <Region minHeight="6" maxHeight="6"/>
            <Button text="Quitar seleccionado" styleClass="btn-secundario" maxWidth="Infinity"
                    onAction="#handleQuitarIngrediente"/>
            <Region minHeight="10" maxHeight="10"/>
            <HBox spacing="8">
                <ComboBox fx:id="cmbIngrediente" styleClass="combo-campo" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                          promptText="Ingrediente..."/>
                <Button text="Agregar" styleClass="btn-secundario" onAction="#handleAgregarIngrediente"/>
            </HBox>
        </VBox>

        <Region minHeight="6" maxHeight="6"/>

        <Label fx:id="lblMensaje" styleClass="form-label" wrapText="true"
               visible="false" managed="false"/>

        <Region VBox.vgrow="ALWAYS"/>
        <Pane styleClass="separador"/>
        <Region minHeight="16" maxHeight="16"/>

        <HBox spacing="10">
            <Button fx:id="btnGuardar" text="Registrar" styleClass="btn-primario"
                    onAction="#handleGuardar" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Limpiar" styleClass="btn-secundario" onAction="#handleNuevo"/>
        </HBox>
    </VBox>
</HBox>
