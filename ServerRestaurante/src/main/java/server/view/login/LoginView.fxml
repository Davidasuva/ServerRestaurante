<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane  fx:controller="server.controller.login.LoginController" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="500.0" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <VBox alignment="CENTER" maxWidth="-Infinity" prefHeight="200.0" prefWidth="320.0" spacing="30.0">
         <children>
            <ImageView id="logo" fx:id="logo" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../../../resources/images/Logo.png" />
               </image>
            </ImageView>
            <TextField id="txtUsuario" fx:id="txtUsuario" alignment="CENTER" promptText="Usuario" style="-fx-background-color: black;" />
            <PasswordField id="txtPasword" fx:id="txtPassword" alignment="BOTTOM_CENTER" promptText="Contraseña" style="-fx-background-color: black;" />
            <Label id="lblError" fx:id="lblError" minHeight="-Infinity" prefHeight="10.0" style="-fx-text-fill: red;" wrapText="true" />
            <Button id="btLoggin" fx:id="btLogin" mnemonicParsing="false" onAction="#onLogin" prefHeight="25.0" prefWidth="162.0" style="-fx-background-color: orange;" text="Iniciar Sesión" textAlignment="CENTER" />
         </children>
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" />
         </padding>
      </VBox>
   </children>
</StackPane>
