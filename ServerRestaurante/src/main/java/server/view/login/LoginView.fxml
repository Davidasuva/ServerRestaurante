<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane styleClass="raiz" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="server.controller.login.LoginController" stylesheets="@LoginView.css">

   <VBox alignment="CENTER" maxWidth="420" spacing="0" styleClass="card">

      <!-- Logo -->
      <HBox alignment="CENTER" spacing="10">
         <ImageView fitHeight="52" fitWidth="52" preserveRatio="true">
            <image>
               <Image url="@/images/Logo.png" />
            </image>
         </ImageView>
         <Label styleClass="logo-texto" text="Carbón y Sazón" />
      </HBox>

      <Region maxHeight="30" minHeight="30" />

      <!-- Usuario -->
      <TextField fx:id="txtUsuario" maxWidth="340" promptText="Usuario" styleClass="campo" />

      <Region maxHeight="12" minHeight="12" />

      <!-- Contraseña -->
      <StackPane maxWidth="340">
         <PasswordField fx:id="txtPassword" promptText="Contraseña" styleClass="campo" />
         <TextField fx:id="txtPasswordVisible" promptText="Contraseña" styleClass="campo" visible="false" />
         <Button fx:id="btnOjo" onAction="#handleTogglePassword" styleClass="btn-ojo" text="👁" StackPane.alignment="CENTER_RIGHT">
            <StackPane.margin><Insets right="10" /></StackPane.margin>
         </Button>
      </StackPane>

      <!-- Error -->
      <Label fx:id="lblError" maxWidth="340" styleClass="label-error" visible="false" wrapText="true">
         <VBox.margin><Insets top="5" /></VBox.margin>
      </Label>

      <Region maxHeight="18" minHeight="18" />

      <!-- Botón -->
      <Button fx:id="btnIngresar" maxWidth="340" onAction="#handleLogin" prefHeight="44" styleClass="btn-ingresar" text="Iniciar sesión" />

      <Region maxHeight="26" minHeight="26" />

   </VBox>

</StackPane>
