<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="server.controller.pedidos.PedidosController"
      styleClass="raiz-admin"
      prefWidth="1100" prefHeight="700">

    <VBox HBox.hgrow="ALWAYS" spacing="0">

        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="20">
            <HBox alignment="CENTER" spacing="8">
                <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                    <image>
                        <Image url="@/images/Logo.png"/>
                    </image>
                </ImageView>
                <Label text="Carbón y Sazón" styleClass="nav-brand"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="mesas" styleClass="nav-link" onAction="#handleIrMesas"/>
            <Button text="pedidos" styleClass="nav-link-active"/>
            <Button text="productos" styleClass="nav-link" onAction="#handleIrProductos"/>
            <Button text="ingredientes" styleClass="nav-link" onAction="#handleIrIngredientes"/>
            <Button text="empleados" styleClass="nav-link" onAction="#handleIrEmpleados"/>
        </HBox>

        <VBox VBox.vgrow="ALWAYS" spacing="0">
            <VBox.margin><Insets top="28" left="28" right="28" bottom="28"/></VBox.margin>

            <!-- ── Encabezado + control del servidor ── -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox spacing="4">
                    <Label text="Pedidos" styleClass="seccion-titulo"/>
                    <Label text="Consulta los pedidos, cambia su estado o método de pago y revisa su detalle."
                           styleClass="seccion-subtitulo"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER" spacing="8" styleClass="estado-caja">
                    <Region fx:id="indicador" styleClass="indicador, indicador-apagado"/>
                    <Label fx:id="lblEstado" text="Servidor apagado" styleClass="estado-texto"/>
                </HBox>
                <Button fx:id="btnConsola" text="Consola ▾" styleClass="btn-consola"
                        onAction="#handleToggleConsola"/>
                <Button fx:id="btnServidor" text="▶  Iniciar servidor" styleClass="btn-iniciar"
                        minWidth="180" onAction="#handleToggleServidor"/>
            </HBox>

            <!-- ── Consola desplegable (arranca cerrada, el controlador anima el alto) ── -->
            <VBox fx:id="panelConsola" styleClass="panel-consola"
                  minHeight="0" prefHeight="0" maxHeight="0">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Consola del servidor" styleClass="consola-titulo"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Limpiar" styleClass="btn-link" onAction="#handleLimpiarConsola"/>
                </HBox>
                <TextArea fx:id="txtConsola" styleClass="consola"
                          editable="false" wrapText="true"
                          promptText="Esperando eventos..."
                          minHeight="170" VBox.vgrow="ALWAYS"/>
            </VBox>

            <Region minHeight="20" maxHeight="20"/>

            <!-- ── Barra de acciones ── -->
            <HBox styleClass="barra-acciones" spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscar"
                           promptText="Buscar por id, mesa, estado o pago..."
                           styleClass="campo-busqueda"
                           prefWidth="340"/>
                <ComboBox fx:id="cmbFiltroEstado" styleClass="combo-campo" prefWidth="170"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Actualizar" styleClass="btn-secundario" onAction="#handleRecargar"/>
                <Button text="+ Nuevo Pedido" styleClass="btn-primario" onAction="#handleNuevo"/>
            </HBox>

            <Region minHeight="14" maxHeight="14"/>

            <!-- ── Tabla ── -->
            <TableView fx:id="tablaPedidos" styleClass="tabla" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="Id" prefWidth="70"/>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="150"/>
                    <TableColumn fx:id="colMesa" text="Mesa" prefWidth="70"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
                    <TableColumn fx:id="colPago" text="Pago" prefWidth="110"/>
                    <TableColumn fx:id="colTotal" text="Total" prefWidth="120"/>
                </columns>
                <placeholder>
                    <Label text="No hay pedidos registrados." styleClass="seccion-subtitulo"/>
                </placeholder>
            </TableView>
        </VBox>
    </VBox>

    <!-- ── Panel derecho: formulario ── -->
    <VBox fx:id="panelForm" visible="false" managed="false" styleClass="panel-form" prefWidth="340" minWidth="340" maxWidth="340" spacing="0">

        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label fx:id="lblTituloForm" text="Nuevo pedido" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="form-titulo"/>
            <Button text="✕ Cerrar" styleClass="btn-link" onAction="#handleCerrarForm"/>
        </HBox>
        <Region minHeight="22" maxHeight="22"/>

        <Label text="Id del pedido" styleClass="form-label"/>
        <Region minHeight="5" maxHeight="5"/>
        <TextField fx:id="txtId" promptText="Ej: 1001" styleClass="campo"/>

        <Region minHeight="10" maxHeight="10"/>
        <Label text="Mesa" styleClass="form-label"/>
        <Region minHeight="5" maxHeight="5"/>
        <ComboBox fx:id="cmbMesa" styleClass="combo-campo" maxWidth="Infinity" promptText="Selecciona la mesa..."/>

        <Region minHeight="10" maxHeight="10"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Fecha:" styleClass="form-label"/>
            <Label fx:id="lblFecha" styleClass="form-label" text="—"/>
        </HBox>
        <Region minHeight="4" maxHeight="4"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Total:" styleClass="form-label"/>
            <Label fx:id="lblTotal" styleClass="form-label" text="—"/>
        </HBox>

        <Region minHeight="10" maxHeight="10"/>
        <Label text="Estado" styleClass="form-label"/>
        <Region minHeight="5" maxHeight="5"/>
        <ComboBox fx:id="cmbEstado" styleClass="combo-campo" maxWidth="Infinity" editable="true"
                  promptText="Selecciona o escribe el estado..."/>

        <Region minHeight="10" maxHeight="10"/>
        <Label text="Método de pago" styleClass="form-label"/>
        <Region minHeight="5" maxHeight="5"/>
        <ComboBox fx:id="cmbPago" styleClass="combo-campo" maxWidth="Infinity" editable="true"
                  promptText="Selecciona o escribe el método..."/>

        <Region minHeight="10" maxHeight="10"/>
        <Label text="Productos" styleClass="form-label"/>
        <Region minHeight="5" maxHeight="5"/>
        <VBox fx:id="boxProductos" spacing="0">
            <ListView fx:id="lstProductos" styleClass="tabla" prefHeight="84" minHeight="84" maxHeight="84"/>
            <Region minHeight="6" maxHeight="6"/>
            <Button text="Quitar seleccionado" styleClass="btn-secundario" maxWidth="Infinity"
                    onAction="#handleQuitarProducto"/>
            <Region minHeight="8" maxHeight="8"/>
            <HBox spacing="8">
                <ComboBox fx:id="cmbProducto" styleClass="combo-campo" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                          promptText="Producto..."/>
                <Button text="Agregar" styleClass="btn-secundario" onAction="#handleAgregarProducto"/>
            </HBox>
        </VBox>

        <Region minHeight="10" maxHeight="10"/>

        <Label text="Encargados" styleClass="form-label"/>
        <Region minHeight="5" maxHeight="5"/>
        <ListView fx:id="lstEncargados" styleClass="tabla" prefHeight="56" minHeight="56" maxHeight="56"/>

        <Region minHeight="6" maxHeight="6"/>

        <Label fx:id="lblMensaje" styleClass="form-label" wrapText="true"
               visible="false" managed="false"/>

        <Region VBox.vgrow="ALWAYS"/>
        <Pane styleClass="separador"/>
        <Region minHeight="16" maxHeight="16"/>

        <HBox spacing="10">
            <Button fx:id="btnGuardar" text="Registrar" styleClass="btn-primario"
                    onAction="#handleGuardar" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Limpiar" styleClass="btn-secundario" onAction="#handleNuevo"/>
        </HBox>
        <Region minHeight="10" maxHeight="10"/>
        <Button fx:id="btnEliminar" text="Eliminar pedido" styleClass="btn-peligro"
                disable="true" maxWidth="Infinity" onAction="#handleEliminar"/>
    </VBox>
</HBox>
