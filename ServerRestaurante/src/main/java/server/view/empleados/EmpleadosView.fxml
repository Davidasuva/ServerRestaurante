<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<HBox prefHeight="700" prefWidth="1100" styleClass="raiz-admin" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="server.controller.employees.EmpleadosController"  stylesheets="@EmpleadosView.css">

   <VBox spacing="0" HBox.hgrow="ALWAYS">

      <HBox alignment="CENTER_LEFT" spacing="20" styleClass="navbar">
         <HBox alignment="CENTER" spacing="8">
            <ImageView fitHeight="28" fitWidth="28" preserveRatio="true">
               <image>
                  <Image url="@/images/Logo.png" />
               </image>
            </ImageView>
            <Label styleClass="nav-brand" text="Carbón y Sazón" />
         </HBox>
         <Region HBox.hgrow="ALWAYS" />
         <Button onAction="#handleIrMesas" styleClass="nav-link" text="mesas" />
         <Button onAction="#handleIrPedidos" styleClass="nav-link" text="pedidos" />
         <Button onAction="#handleIrProductos" styleClass="nav-link" text="productos" />
         <Button onAction="#handleIrIngredientes" styleClass="nav-link" text="ingredientes" />
         <Button styleClass="nav-link-active" text="empleados" />
      </HBox>

      <VBox spacing="0" VBox.vgrow="ALWAYS">
         <VBox.margin><Insets bottom="28" left="28" right="28" top="28" /></VBox.margin>

         <!-- ── Encabezado + control del servidor ── -->
         <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="4">
               <Label styleClass="seccion-titulo" text="Empleados" />
               <Label styleClass="seccion-subtitulo" text="Gestiona el personal del restaurante: meseros, cocina y caja." />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="8" styleClass="estado-caja">
               <Region fx:id="indicador" styleClass="indicador, indicador-apagado" />
               <Label fx:id="lblEstado" styleClass="estado-texto" text="Servidor apagado" />
            </HBox>
            <Button fx:id="btnConsola" onAction="#handleToggleConsola" styleClass="btn-consola" text="Consola ▾" />
            <Button fx:id="btnServidor" minWidth="180" onAction="#handleToggleServidor" styleClass="btn-iniciar" text="▶  Iniciar servidor" />
         </HBox>

         <!-- ── Consola desplegable (arranca cerrada, el controlador anima el alto) ── -->
         <VBox fx:id="panelConsola" maxHeight="0" minHeight="0" prefHeight="0" styleClass="panel-consola">
            <HBox alignment="CENTER_LEFT">
               <Label styleClass="consola-titulo" text="Consola del servidor" />
               <Region HBox.hgrow="ALWAYS" />
               <Button onAction="#handleLimpiarConsola" styleClass="btn-link" text="Limpiar" />
            </HBox>
            <TextArea fx:id="txtConsola" editable="false" minHeight="170" promptText="Esperando eventos..." styleClass="consola" wrapText="true" VBox.vgrow="ALWAYS" />
         </VBox>

         <Region maxHeight="20" minHeight="20" />

         <!-- ── Barra de acciones ── -->
         <HBox alignment="CENTER_LEFT" spacing="10" styleClass="barra-acciones">
            <TextField fx:id="txtBuscar" prefWidth="340" promptText="Buscar por nombre, cédula o cargo..." styleClass="campo-busqueda" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleRecargar" styleClass="btn-secundario" text="Actualizar" />
            <Button onAction="#handleNuevo" styleClass="btn-primario" text="+ Nuevo Empleado" />
         </HBox>

         <Region maxHeight="14" minHeight="14" />

         <!-- ── Tabla ── -->
         <TableView fx:id="tablaEmpleados" styleClass="tabla" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="colCedula" prefWidth="140" text="Cédula" />
               <TableColumn fx:id="colNombre" prefWidth="260" text="Nombre" />
               <TableColumn fx:id="colCargo" prefWidth="180" text="Cargo" />
            </columns>
            <placeholder>
               <Label styleClass="seccion-subtitulo" text="No hay empleados registrados." />
            </placeholder>
         </TableView>
      </VBox>
   </VBox>

   <!-- ── Panel derecho: formulario ── -->
   <VBox fx:id="panelForm" managed="false" maxWidth="320" minWidth="320" prefWidth="320" spacing="0" styleClass="panel-form" visible="false">

      <HBox alignment="CENTER_LEFT" spacing="8">
         <Label fx:id="lblTituloForm" maxWidth="Infinity" styleClass="form-titulo" text="Nuevo empleado" HBox.hgrow="ALWAYS" />
         <Button onAction="#handleCerrarForm" styleClass="btn-link" text="✕ Cerrar" />
      </HBox>
      <Region maxHeight="22" minHeight="22" />

      <Label styleClass="form-label" text="Cédula" />
      <Region maxHeight="5" minHeight="5" />
      <TextField fx:id="txtCedula" promptText="Ej: 1234567890" styleClass="campo" />

      <Region maxHeight="14" minHeight="14" />

      <Label styleClass="form-label" text="Nombre" />
      <Region maxHeight="5" minHeight="5" />
      <TextField fx:id="txtNombre" promptText="Ej: Juan Pérez" styleClass="campo" />

      <Region maxHeight="14" minHeight="14" />

      <Label styleClass="form-label" text="Cargo" />
      <Region maxHeight="5" minHeight="5" />
      <ComboBox fx:id="cmbCargo" editable="true" maxWidth="Infinity" promptText="Selecciona o escribe el cargo..." styleClass="combo-campo" />

      <Region maxHeight="14" minHeight="14" />

      <Label styleClass="form-label" text="Contraseña" />
      <Region maxHeight="5" minHeight="5" />
      <PasswordField fx:id="txtContrasena" promptText="Contraseña" styleClass="campo" />

      <Region maxHeight="6" minHeight="6" />

      <Label fx:id="lblMensaje" managed="false" styleClass="form-label" visible="false" wrapText="true" />

      <Region VBox.vgrow="ALWAYS" />
      <Pane styleClass="separador" />
      <Region maxHeight="16" minHeight="16" />

      <HBox spacing="10">
         <Button fx:id="btnGuardar" maxWidth="Infinity" onAction="#handleGuardar" styleClass="btn-primario" text="Registrar" HBox.hgrow="ALWAYS" />
         <Button onAction="#handleNuevo" styleClass="btn-secundario" text="Limpiar" />
      </HBox>
      <Region maxHeight="10" minHeight="10" />
      <Button fx:id="btnEliminar" disable="true" maxWidth="Infinity" onAction="#handleEliminar" styleClass="btn-peligro" text="Eliminar empleado" />
   </VBox>
</HBox>
