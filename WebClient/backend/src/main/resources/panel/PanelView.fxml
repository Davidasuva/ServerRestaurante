<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane styleClass="raiz" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyectoApi.api.views.ui.panel.PanelController" stylesheets="@PanelView.css">

   <VBox alignment="CENTER" maxWidth="460" spacing="0" styleClass="card">

      <!-- Logo -->
      <HBox alignment="CENTER" spacing="10">
         <ImageView fitHeight="52" fitWidth="52" preserveRatio="true">
            <image>
               <Image url="@/images/Logo.png" />
            </image>
         </ImageView>
         <Label styleClass="logo-texto" text="Carbón y Sazón" />
      </HBox>

      <Region maxHeight="8" minHeight="8" />
      <Label styleClass="subtitulo" text="Vista móvil" />

      <Region maxHeight="26" minHeight="26" />

      <!-- Estado -->
      <HBox alignment="CENTER" spacing="8">
         <Circle fx:id="puntoEstado" radius="6" styleClass="punto-apagado" />
         <Label fx:id="lblEstado" styleClass="label-estado" text="Vista móvil apagada" />
      </HBox>

      <Region maxHeight="18" minHeight="18" />

      <!-- Botón -->
      <Button fx:id="btnToggle" maxWidth="340" onAction="#handleToggle" prefHeight="44" styleClass="btn-ingresar" text="Iniciar vista móvil" />

      <!-- Direcciones -->
      <Label fx:id="lblUrls" alignment="CENTER" maxWidth="380" styleClass="label-urls" textAlignment="CENTER" visible="false" managed="false" wrapText="true">
         <VBox.margin><Insets top="18" /></VBox.margin>
      </Label>

      <!-- Error -->
      <Label fx:id="lblError" alignment="CENTER" maxWidth="380" styleClass="label-error" textAlignment="CENTER" visible="false" managed="false" wrapText="true">
         <VBox.margin><Insets top="12" /></VBox.margin>
      </Label>

      <Region maxHeight="26" minHeight="26" />

   </VBox>

</StackPane>
